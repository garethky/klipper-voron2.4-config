{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔍 Check Whitespace",
            "type": "shell",
            "command": "../klipper/scripts/check_whitespace.sh",
            "problemMatcher": []
        },
        {
            "label": "🧹 Clear klipper.log",
            "type": "shell",
            "command": "ssh pi@voron24.local 'truncate -s 0 /home/pi/printer_data/logs/klippy.log*' ",
            "problemMatcher": []
        },
        {
            "label": "🧹 Clear moonraker.log",
            "type": "shell",
            "command": "ssh pi@voron24.local 'truncate -s 0 /home/pi/printer_data/logs/moonraker.log*' ",
            "problemMatcher": []
        },
        {
            "label": "🧹 Clear KlipperScreen.log",
            "type": "shell",
            "command": "ssh pi@voron24.local 'truncate -s 0 /home/pi/printer_data/logs/KlipperScreen.log*' ",
            "problemMatcher": []
        },
        {
            "label": "🧹 Clear loadcell.log",
            "type": "shell",
            "command": "ssh pi@voron24.local 'truncate -s 0 /home/pi/printer_data/logs/loadcell.log' ",
            "problemMatcher": []
        },
        {
            "label": "⏯️ Restart Klipper",
            "type": "shell",
            "command": "ssh pi@voron24.local 'sudo service klipper restart'",
            "dependsOn": ["🧹 Clear klipper.log"],
            "problemMatcher": []
        },
        {
            "label": "📦 Deploy Klipper",
            "type": "shell",
            "command": "rsync -iahpr --exclude={\".*\",\"*.pyc\",\"board/*\",\"out/*\"} ../klipper pi@voron24.local:/home/pi/",
            "problemMatcher": []
        },
        {
            "label": "📦 Deploy Printer Config",
            "type": "shell",
            "command": "rsync -iahp ./printer_data/config/* pi@voron24.local:/home/pi/printer_data/config/",
            "problemMatcher": []
        },
        {
            "label": "📦 + ⏯️ Deploy & Restart Klipper",
            "dependsOn": ["📦 Deploy Printer Config", "📦 Deploy Klipper", "⏯️ Restart Klipper"],
            "problemMatcher": []
        },
        {
            "label": "⚡ Flash MCU Klipper",
            "type": "shell",
            "command": "ssh pi@voron24.local './printer_data/config/flash_mcu.sh'",
            "problemMatcher": []
        },
        {
            "label": "⚡ Flash MCU Katapult",
            "type": "shell",
            "command": "ssh pi@voron24.local './printer_data/config/flash_mcu_katapult.sh'",
            "problemMatcher": []
        },
        {
            "label": "🛠️ Make Firmware",
            "type": "shell",
            "command": "ssh pi@voron24.local 'cd ./klipper; make'",
            "problemMatcher": []
        },
        {
            "label": "voron24_deploy_clibration_prints",
            "type": "shell",
            "command": "rsync -iahp ./printer_data/gcodes/* pi@voron24.local:/home/pi/printer_data/gcodes/",
            "problemMatcher": []
        },
        {
            "label": "voron24_backup_variables",
            "type": "shell",
            "command": "rsync pi@voron24.local:/home/pi/printer_data/variables.cfg ./printer_data/",
            "problemMatcher": []
        }
    ]
}